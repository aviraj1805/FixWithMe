# Copy to apps/api/.env for local development. Never commit real keys.
FWM_ENV=dev
FWM_CORS_ORIGINS=["http://localhost:3000"]

# Providers are tried in order; unconfigured ones are skipped.
FWM_LLM_CHAIN=["gemini","ollama"]

# Get a free key at https://aistudio.google.com/apikey. Check the per-model free limits there.
FWM_GEMINI_API_KEY=
FWM_GEMINI_MODELS=["gemini-3.5-flash-lite","gemini-3.1-flash-lite"]
FWM_GEMINI_TIMEOUT_S=20
FWM_GEMINI_THINKING_LEVEL=low

# Local Gemma 4 via Ollama (dev, eval, fallback): `ollama pull gemma4:e4b`
FWM_OLLAMA_BASE_URL=http://localhost:11434
FWM_OLLAMA_MODEL=gemma4:e4b
